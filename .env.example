# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# SERVER ONLY. Never expose. Used to create/manage chair accounts and by scripts/bootstrap-admin.mjs
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- Global conference access code (everyone must enter this to see the site) ----
CONFERENCE_ACCESS_CODE=PASMUN-2026-CHANGE-ME
# Long random string used to sign the access cookie (e.g. `openssl rand -hex 32`)
ACCESS_COOKIE_SECRET=replace-with-a-long-random-string

# ---- Public address of the site (used in emailed set-password links) ----
# Set to your live domain on Vercel, e.g. https://managepasmun.vercel.app (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
